APP_ENV=development
# Para PostgreSQL local via Docker Compose:
DATABASE_URL=postgresql+psycopg://fraudguard:fraudguard_dev_password@localhost:5432/fraudguard
# Para Supabase PostgreSQL (exemplo fictício com SSL):
# DATABASE_URL=postgresql+psycopg://postgres.projectref:YOUR_SUPABASE_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_DATABASE_URL=postgresql+psycopg://fraudguard:fraudguard_dev_password@localhost:5432/fraudguard

MODEL_ARTIFACT_PATH=ml/artifacts/1.0.0/pipeline.joblib
MODEL_FEATURE_SCHEMA_VERSION=creditcard-2023-v1

# Autenticação: local_private ou jwt
API_AUTH_MODE=local_private
ANALYST_API_TOKEN=fg-dev-analyst-token-change-me
ADMIN_API_TOKEN=fg-dev-admin-token-change-me
JWT_SECRET_KEY=fg-dev-jwt-secret-not-for-production
JWT_ALGORITHM=HS256

CSV_DATA_DIR=.
STREAMLIT_API_BASE_URL=http://localhost:8000/api/v1
LOG_LEVEL=INFO

